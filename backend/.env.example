# Copy this file to .env and fill in real values. Never commit .env.
#
# MongoDB Atlas connection string (Atlas > Connect > Drivers).
# Only the cluster address and credentials are used from it; the database name
# comes from config/mongoid.yml (mysms_development / mysms_test).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# SMS provider: "fake" sends nothing and needs no credentials; "twilio" sends
# real messages and requires the three TWILIO_ variables below.
SMS_PROVIDER=fake
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=<your-auth-token>
TWILIO_FROM_NUMBER=<your-twilio-number>
